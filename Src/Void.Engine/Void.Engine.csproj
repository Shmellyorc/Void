<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageIcon>Icon.png</PackageIcon>
    <PackageId>Void.Engine</PackageId>
    <Version>1.1.0</Version>
    <Authors>Shmellyorc</Authors>
    <Company>Void Engine</Company>
    <Description>Lightweight 2D game framework for .NET with batched rendering, asset protection (AES-GCM), pathfinding (A* + flow fields), coroutines, LDtk level editor support, encrypted saving, mod support, and post-processing shaders.</Description>
    <Copyright>Copyright (c) 2026 Void Engine</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Shmellyorc/Void</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Shmellyorc/Void</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>game-engine;2d;game-framework;dotnet;sfml;rendering;pathfinding;coroutines;ldtk;asset-management;audio;input;modding;encryption;shaders;post-processing;cross-platform;open-source</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReleaseNotes>
    [1.1.0] 2026.09.01
      * CollisionHelper class with full collision detection and resolution:
      * Primitives: IsWithinRadius, IsCircleOverlap, ClosestPointRect, ClosestPointCircle, LineLine
      * Shape to Shape: RectRect, CircleCircle, RectCircle
      * Point to Shape: PointRect, PointCircle
      * Line to Shape: LineLine, LineRect, LineCircle
      * Distance Between Shapes: DistanceRectRect, DistanceCircleCircle, DistanceRectCircle
      * Raycasting: RaycastRect, RaycastCircle, RaycastAny
      * Swept Collision (prevents tunneling): SweptRectRect, SweptCircleRect, SweptCircleCircle
      * Collision Normals: GetCollisionNormal (Rect, Circle, Circle-Circle)
      * Reflection: Reflect velocity off surfaces
      * Containment: RectContainsRect, RectContainsCircle, CircleContainsCircle, CircleContainsRect
      * Pushback: PushRectRect, PushCircleRect, PushCircleCircle
      * Move and Slide: MoveAndSlideRect, MoveAndSlideCircle
      * Bounds Conversion: GetCircleBounds (for broadphase optimization)
      * Rect2 now delegates all collision logic to CollisionHelper
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SFML.Net" Version="3.0.0" />
    <ProjectReference Include="..\Void.Packer\Void.Packer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\Images\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Data\**\*" />
  </ItemGroup>
</Project>
