<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageIcon>Icon.png</PackageIcon>
    <PackageId>Void.Engine</PackageId>
    <Version>2.0.0</Version>
    <Authors>Shmellyorc</Authors>
    <Company>Void Engine</Company>
    <Description>Modular 2D game framework for .NET with pluggable rendering, SDL3 platform support, OpenAL audio, asset management, pathfinding, coroutines, LDtk support, encrypted saving, and post-processing.</Description>
    <Copyright>Copyright (c) 2026 Void Engine</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Shmellyorc/Void</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Shmellyorc/Void</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>game-engine;2d;game-framework;dotnet;sdl3;silk-net;opengl;rendering;pluggable-renderer;renderer-api;pathfinding;coroutines;ldtk;asset-management;openal;audio;input;modding;encryption;shaders;post-processing;cross-platform;open-source</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReleaseNotes>
    [2.0.0] 2026.9.12

      Major architecture update:
      * Removed the SFML.Net dependency from VOID Engine
      * SDL3-CS now owns windowing, displays, fullscreen modes, events, keyboard, mouse, gamepads, and OpenGL context creation
      * Added the built-in renderer using Silk.NET.OpenGL
      * Added public renderer-neutral contracts for external Vulkan, Direct3D, Metal, OpenGL, or custom renderer backends
      * Added native window-handle access through IRendererContext for renderer plugins where the active platform supports it
      * Reworked textures, shaders, render targets, atlas handling, and graphics resources around renderer-neutral APIs
      * Replaced SFML audio with Silk.NET.OpenAL and NAudio.SoundFile decoding
      * Added multi-monitor/display APIs and Linux X11/XWayland/Wayland backend selection
      * Preserved the high-level SpriteBatcher, PrimitiveBatcher, asset, camera, font, and game lifecycle workflows
      * Refreshed public documentation, wiki pages, and runnable examples for the new architecture

      Breaking changes:
      * SFML-specific public types and dependencies are no longer part of VOID
      * Custom platform, renderer, shader, texture, render-target, or audio integrations may need to migrate to the new public contracts
      * Renderer plugins should use IRendererBackend, IGraphicsDevice, and IRendererContext instead of depending on VOID's internal SDL implementation
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.SoundFile" Version="3.0.1" />
    <PackageReference Include="SDL3-CS" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.16" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <ProjectReference Include="..\Void.Packer\Void.Packer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\Images\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Data\**\*" />
  </ItemGroup>
</Project>
